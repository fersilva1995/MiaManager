<Window x:Class="MiaManager.Mia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MiaManager"
        mc:Ignorable="d"
        Title="Mia" 
        Height="450" 
        Width="800"
        WindowState="Maximized"
        WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0">
            <Border Background="WhiteSmoke">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Logo" Grid.Column="0"></Image>
                    
                    <Button Grid.Column="2"
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <materialDesign:PackIcon Kind="WindowMinimize"                                               
                                                     Foreground="Black"/>
                    </Button>
                    <Button Grid.Column="3" 
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <materialDesign:PackIcon Kind="WindowMaximize"
                                                     Foreground="Black"/>
                    </Button>
                    <Button Grid.Column="4"
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <materialDesign:PackIcon Kind="WindowClose"
                                                     Foreground="Black"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="Body" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Menu" Grid.Row="0">
                <Border Background="WhiteSmoke"></Border>
            </Grid>
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Back" 
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="Back_Click">
                        <materialDesign:PackIcon Kind="ArrowBack"
                                                 Foreground="Black"/>
                    </Button>
                    <Button x:Name="Foward" 
                            Click="Foward_Click"
                            Background="Transparent"
                            BorderBrush="Transparent">
                        <materialDesign:PackIcon Kind="ArrowForward"
                                                 Foreground="Black"/>


                    </Button>
                    <Button x:Name="UserPage" Click="UserPage_Click">Usuários</Button>
                    <Button x:Name="SvmPage" Click="SvmPage_Click">Treinamento</Button>
                    <Button x:Name="RecognitionPage" Click="RecognitionPage_Click" >Reconhecimento</Button>
                    <Button x:Name="ReportPage" Click="ReportPage_Click" Content="Relatorios"/>
                </StackPanel>
            </Border>
            <Border x:Name="Main" 
                    Grid.Row="1" 
                    Background="#DFDFDF">
                <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Grid>
</Window>
