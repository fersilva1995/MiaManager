<Window x:Class="MiaManager.Mia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiaManager"
        mc:Ignorable="d"
        Title="Mia" 
        Height="450" 
        Width="800"
        WindowState="Maximized"
        WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0">
            <Border Background="WhiteSmoke">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Logo" Grid.Column="0"></Image>
                    <Border x:Name="Minimize" 
                            Grid.Column="2"
                            Margin="5">
                        <Button></Button>
                    </Border>
                    <Border x:Name="Maximize"
                            Grid.Column="3"
                            Margin="5">
                        <Button></Button>
                    </Border>
                    <Border x:Name="Close"
                            Grid.Column="4"
                            Margin="5">
                        <Button></Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="Body" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Menu" Grid.Row="0">
                <Border Background="WhiteSmoke"></Border>
            </Grid>
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Back" Click="Back_Click"></Button>
                    <Button x:Name="Foward" Click="Foward_Click"></Button>
                    <Button x:Name="UserPage" Click="UserPage_Click">Usuários</Button>
                    <Button x:Name="SvmPage" Click="SvmPage_Click">Treinamento</Button>
                    <Button x:Name="RecognitionPage" Click="RecognitionPage_Click" >Reconhecimento</Button>
                    <Button x:Name="ReportPage" Click="ReportPage_Click" Content="Relatorios"/>
                </StackPanel>
            </Border>
            <Border x:Name="Main" 
                    Grid.Row="1" 
                    Background="#DFDFDF">
                <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Grid>
</Window>
