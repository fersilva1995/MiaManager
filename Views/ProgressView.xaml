<Window x:Class="MiaManager.Views.ProgressView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiaManager.Views"
        xmlns:vm="clr-namespace:MiaManager.ViewModels"
        mc:Ignorable="d"
        Title="ProgressView" 
        Height="270" 
        Width="500"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:ProgressViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Text}"
                   FontSize="18"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <ProgressBar Grid.Row="1"
                     Margin="10 0 10 0"
                     Height="30"
                     Value="{Binding Value}" 
                     Maximum="{Binding Max}" ValueChanged="ProgressBar_ValueChanged"/>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center">
            <TextBlock FontSize="20" Text="{Binding Value}"/>
            <TextBlock FontSize="20" Text="/"/>
            <TextBlock FontSize="20" Text="{Binding Max}"/>
        </StackPanel>
        <Button Grid.Row="3"
                VerticalAlignment="Top"
                Height="40"
                FontSize="16"
                Background="DarkGray"
                Width="200"
                Content="Cancelar" Click="Button_Click"/>
    </Grid>
</Window>
