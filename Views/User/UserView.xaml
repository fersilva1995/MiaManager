<Page x:Class="MiaManager.Views.UserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiaManager.Views"
      xmlns:vm="clr-namespace:MiaManager.ViewModels"
      d:DataContext="{d:DesignInstance Type=vm:UserViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserView">
    <Page.DataContext>
        <vm:UserViewModel/>
    </Page.DataContext>

    <Grid x:Name="Main">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Name}"/>
            <TextBlock Grid.Column="1" Text="{Binding Id}"/>
        </Grid>
        <Grid x:Name="Body" Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Carregar imagens" 
                        Command="{Binding LoadCommand}"
                        CommandParameter="images" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Carregar geradas" 
                        Command="{Binding LoadCommand}"
                        CommandParameter="aug_images" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Carregar faces" 
                        Command="{Binding LoadCommand}"
                        CommandParameter="faces" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Carregar caracteristicas" 
                        Command="{Binding LoadCommand}"
                        CommandParameter="face_features" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Carregar tudo" 
                        Command="{Binding LoadAllDataCommand}"
                        CommandParameter="face_features" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Remover tudo" 
                        Command="{Binding RemoveAllCommand}"
                        CommandParameter="face_features" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        x:Name="clearButton"
                        Content="Limpar selecao" 
                        Margin="10" Click="clearButton_Click"/>
                <Button Grid.Column="1" 
                        x:Name="selectAllButton"
                        Content="Selecionar todos" 
                        Margin="10" Click="selectAllButton_Click"/>

            </StackPanel>
            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal">
                <Button Content="Adicionar imagens" 
                        Command="{Binding AddCommand}"
                        CommandParameter="images" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Adicionar gerada" 
                        Command="{Binding AddCommand}"
                        CommandParameter="aug_images" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Adicionar face" 
                        Command="{Binding AddCommand}"
                        CommandParameter="faces" 
                        Margin="10"/>
                <Button Grid.Column="1" 
                        Content="Adicionar caracteristica" 
                        Command="{Binding AddCommand}"
                        CommandParameter="face_features" 
                        Margin="10"/>
                <TextBlock Text="{Binding ElementName=DataListView, Path=Items.Count, StringFormat='Total Rows: {0}'}" 
                   FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/>
            </StackPanel>
            <ListView Grid.Row="2" 
                      Grid.ColumnSpan="2" 
                      x:Name="DataListView"
                      SelectionMode="Extended"
                      ItemsSource="{Binding Data}" SelectionChanged="ListView_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.Template>
                    <ControlTemplate TargetType="ListView">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListView.Template>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Id}"/>
                            <Button Content="Mostrar Imagem" Command="{Binding LoadDataCommand}"></Button>
                            <Button Content="Deletar Imagem" Command="{Binding RemoveDataCommand}" Background="Crimson"/>
                            <Image MaxWidth="200" Source="{Binding Image}" Stretch="Uniform" />
                            <TextBlock MaxWidth="200" Text="{Binding Value}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>
    </Grid>
</Page>
