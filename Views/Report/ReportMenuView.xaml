<Page x:Class="MiaManager.Views.ReportMenuView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiaManager.Views"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:vm="clr-namespace:MiaManager.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportMenuView">
    <Page.DataContext>
        <vm:ReportMenuViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="ReportIndex"
                Grid.Column="0"
                BorderBrush="LightGray"
                BorderThickness="0 0 2 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding Header}"/>


                    <Button Grid.Column="1" 
                            Width="70"
                            Background="Green"
                            BorderBrush="Transparent"
                            Click="Button_Click">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <Button Grid.Column="2" 
                            Width="70"
                            Background="DodgerBlue"
                            BorderBrush="Transparent"
                            Command="{Binding RefreshReportsCommand}">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="White"/>
                    </Button>


                </Grid>
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Reports}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Id}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </Grid>



        </Border>
        <Frame x:Name="ReportFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
